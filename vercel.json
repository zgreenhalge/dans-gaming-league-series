{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/vercel-ignore-build.mts",
  "crons": [
    {
      "path": "/api/cron/refresh-steam",
      "schedule": "0 4 * * *"
    }
  ],
  "functions": {
    "api/ehog/recompute.py": {
      "runtime": "@vercel/python@6.45.0",
      "includeFiles": "ehog/**",
      "excludeFiles": "{src/**,public/**,docs/**,e2e/**,supabase/**,scripts/**,infra/**,node_modules/**,.next/**}"
    }
  }
}
