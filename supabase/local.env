# Connection values for the throwaway local Supabase stack (`supabase start`, see docs/e2e.md).
# Fixed and safe to commit: the URL is `supabase/config.toml`'s pinned `api.port`, and the anon/
# service_role values are JWTs derived from that same file's pinned `auth.jwt_secret` (role: anon /
# service_role, iss: supabase-demo) — deterministic for this repo's local stack, not real secrets,
# and never valid against the real DGLS Supabase project. Recent Supabase CLI releases stopped
# reliably printing these from `supabase status`/`start` output (a known upstream regression,
# supabase/cli#4211), so this file is the single source of truth every consumer reads instead:
# `docs/e2e.md`'s manual setup, `.claude/hooks/session-start.sh`'s automatic bootstrap, and
# `.github/workflows/ci.yml`'s `e2e` job.
#
# Plain dotenv format — `set -a; source supabase/local.env; set +a` in a shell, or
# `cat supabase/local.env >> "$GITHUB_ENV"` in a GitHub Actions step.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjIxNDU5MTY4MDB9.SD8OGMUA7SztCSQyoNK_up2hNla9czXlhL7RvNeh1kw
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MjE0NTkxNjgwMH0.Q_XOunt2yFrXAkYRNeh5JgAO_M_zLBEh7OwNnfEJjXU
